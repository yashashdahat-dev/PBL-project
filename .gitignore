# ==============================================================================
# Git Ignore - I-MACSI Research & Simulation Repository
# ==============================================================================

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.pyo

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- IDE, Editor, and OS Temporary Files ---
.vscode/
.idea/
*.swp
*.swo
*~
tempCodeRunnerFile.*
.DS_Store
Thumbs.db
ehthumbs.db
*.tmp
*.log

# --- Frontend Build Artifacts & Node Modules ---
frontend/node_modules/
frontend/dist/
frontend/.cache/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- LaTeX Build Intermediates ---
*.aux
*.bbl
*.blg
*.brf
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.lot
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.xdv

# --- Standalone TeX Compiler Binaries & Archives ---
tectonic_bin/
*.zip

# --- Ephemeral Simulation Snapshots & Test Output ---
**/*snapshot.png
*snapshot.png
paper_preview_*.png
page_*.png
test_*.pdf
test_*.png
Figure_1.png
